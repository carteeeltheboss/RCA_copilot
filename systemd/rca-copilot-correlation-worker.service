[Unit]
Description=RCA Copilot correlation worker
After=network-online.target mongod.service
Wants=network-online.target
Requires=mongod.service
ConditionPathExists=/etc/rca-copilot/rca-copilot.conf

[Service]
User=rca-copilot
Group=rca-copilot
RuntimeDirectory=rca-copilot
StateDirectory=rca-copilot
StateDirectoryMode=0770
EnvironmentFile=-/etc/rca-copilot/rca-copilot.env
ExecStart=/usr/bin/rca-copilot-correlation-worker --config-file /etc/rca-copilot/rca-copilot.conf
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
