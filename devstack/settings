# RCA Copilot DevStack settings
RCA_COPILOT_DIR=${RCA_COPILOT_DIR:-$DEST/rca-copilot}
RCA_COPILOT_CONF_DIR=${RCA_COPILOT_CONF_DIR:-/etc/rca-copilot}
RCA_COPILOT_CONF=${RCA_COPILOT_CONF:-$RCA_COPILOT_CONF_DIR/rca-copilot.conf}
RCA_COPILOT_STATE_DIR=${RCA_COPILOT_STATE_DIR:-$DATA_DIR/rca-copilot}
# Follow SERVICE_HOST if the operator hasn't set RCA_COPILOT_HOST explicitly.
# This ensures the Keystone endpoint and health checks target the right address
# on multi-node or non-loopback DevStack deployments.
if [[ -n "${SERVICE_HOST:-}" && -z "${RCA_COPILOT_HOST:-}" ]]; then
    RCA_COPILOT_HOST="$SERVICE_HOST"
fi
RCA_COPILOT_HOST=${RCA_COPILOT_HOST:-127.0.0.1}
# Port 18000 avoids conflicts with DevStack services that commonly use 8000
# (e.g. Keystone under eventlet). Override with RCA_COPILOT_PORT if needed.
RCA_COPILOT_PORT=${RCA_COPILOT_PORT:-18000}
RCA_COPILOT_MONGO_USER=${RCA_COPILOT_MONGO_USER:-rca_admin}
RCA_COPILOT_MONGO_PASSWORD=${RCA_COPILOT_MONGO_PASSWORD:-}
RCA_COPILOT_MONGO_URI=${RCA_COPILOT_MONGO_URI:-}
RCA_COPILOT_MONGO_DATABASE=${RCA_COPILOT_MONGO_DATABASE:-rca_copilot}
RCA_COPILOT_INTERNAL_SERVICE_TOKEN=${RCA_COPILOT_INTERNAL_SERVICE_TOKEN:-}
RCA_COPILOT_PROVIDER_MASTER_KEY=${RCA_COPILOT_PROVIDER_MASTER_KEY:-}
RCA_COPILOT_PROVIDER_ALLOWED_HOSTS=${RCA_COPILOT_PROVIDER_ALLOWED_HOSTS:-}
RCA_COPILOT_HORIZON_ENABLED=${RCA_COPILOT_HORIZON_ENABLED:-True}
RCA_COPILOT_BIN_DIR=${RCA_COPILOT_BIN_DIR:-$(get_python_exec_prefix)}
RCA_COPILOT_MONGO_IMAGE=${RCA_COPILOT_MONGO_IMAGE:-mongo:7.0.12}
RCA_COPILOT_MONGO_CONTAINER=${RCA_COPILOT_MONGO_CONTAINER:-rca-copilot-mongodb}
RCA_COPILOT_SECRETS_FILE=${RCA_COPILOT_SECRETS_FILE:-$DATA_DIR/rca-copilot/devstack-secrets}

enable_service rca-api rca-collector rca-parser rca-correlation rca-incident rca-enrichment
